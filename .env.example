# Server
PORT=8787
APP_BASE_URL=http://localhost:8787

# Provider selection — owned adapters only, no vendor fallbacks.
VOICE_PROVIDER=twilio
BROWSER_PROVIDER=playwright
MAIL_PROVIDER=gmail
MEMORY_PROVIDER=pgvector
PAYMENT_PROVIDER=sponge

# Owned Twilio VoiceCaller adapter (T11 — primary voice provider).
# Without TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN, the adapter runs in simulation mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=       # E.164 format, e.g. +15551234567
TWILIO_STATUS_CALLBACK_URL=  # optional: public URL for call status webhooks

# Owned Playwright browser adapter (T8).
# Set PLAYWRIGHT_ENABLED=true to launch a real Chromium browser.
# Without it, the adapter runs in simulation mode.
PLAYWRIGHT_ENABLED=false
# Optional: path for persistent browser profiles (cookies/sessions).
PLAYWRIGHT_USER_DATA_DIR=

# Owned Gmail/SMTP mailer adapter (T9).
# Set GMAIL_USER + GMAIL_APP_PASSWORD to send real email via Gmail SMTP.
# Without them, the adapter runs in simulation mode.
# Use a Gmail App Password (not your account password):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# pgvector memory adapter (T5 — owned, primary).
# Requires a Postgres instance with the pgvector extension installed.
# PGVECTOR_DATABASE_URL takes precedence; falls back to DATABASE_URL.
DATABASE_URL=postgresql://localhost:5432/gofer
PGVECTOR_DATABASE_URL=

# OpenAI embeddings — used by the pgvector adapter and Twilio transcription.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Stripe payments adapter (T13 — not yet implemented; sponge stub is active).
STRIPE_SECRET_KEY=

# Approval token secret for HMAC-SHA256 gate tokens (control/gates.js).
# Use a long random string, e.g.: openssl rand -hex 32
APPROVAL_TOKEN_SECRET=

# Demo recipient addresses for live-action testing.
DEMO_USER_PHONE=
DEMO_USER_EMAIL=
DEMO_TEST_RECIPIENT_PHONE=
DEMO_TEST_RECIPIENT_EMAIL=

# Safety toggles for live actions.
DEMO_MODE=true
ALLOW_REAL_SMS_SEND=false
ALLOW_REAL_EMAIL_SEND=false
ALLOW_REAL_RESTAURANT_CALLS=false
