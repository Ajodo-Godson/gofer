# Server
PORT=8787
APP_BASE_URL=http://localhost:8787

# Optional real integrations. Without these, GOFER runs in live simulated mode.
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_FROM_NUMBER=
AGENTPHONE_WEBHOOK_SECRET=
AGENTPHONE_BASE_URL=https://api.agentphone.to/v1

BROWSER_USE_API_KEY=
BROWSER_USE_API_BASE_URL=https://api.browser-use.com/api/v1
BROWSER_USE_WORKSPACE_ID=
# Required for fast DoorDash/OAuth-style demos. Sync cookies with Browser Use profile sync,
# then paste the profile ID here.
BROWSER_USE_PROFILE_ID=

AGENTMAIL_API_KEY=
AGENTMAIL_FROM=
AGENTMAIL_INBOX_ID=
# Webhook signing secret from the AgentMail console (starts with whsec_).
# Required to verify inbound message webhooks at /api/agentmail/webhook.
AGENTMAIL_WEBHOOK_SECRET=

SUPERMEMORY_API_KEY=
SUPERMEMORY_USER_ID=demo-user
SUPERMEMORY_PROJECT_ID=gofer

MOSS_API_KEY=
# Moss SDK credentials (real retrieval). Get from the Moss console.
# When MOSS_PROJECT_ID + MOSS_PROJECT_KEY are set, retrieveMossContext
# uses the SDK against the index named MOSS_INDEX_NAME. If unset, GOFER
# falls back to a local corpus match against data/moss-corpus/*.json.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=gofer-dental-call
SPONGE_API_KEY=
STRIPE_SECRET_KEY=

# Owned Playwright browser adapter (T8).
# Set PLAYWRIGHT_ENABLED=true to launch a real Chromium browser.
# Without it, the adapter runs in simulation mode.
PLAYWRIGHT_ENABLED=false
# Optional: path for persistent browser profiles (cookies/sessions).
PLAYWRIGHT_USER_DATA_DIR=

# Owned Gmail/SMTP mailer adapter (T9).
# Set GMAIL_USER + GMAIL_APP_PASSWORD to send real email via Gmail SMTP.
# Without them, the adapter runs in simulation mode.
# Use a Gmail App Password (not your account password):
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Demo recipient for SMS/email/call actions once real integrations are enabled.
DEMO_USER_PHONE=
DEMO_USER_EMAIL=
DEMO_TEST_RECIPIENT_PHONE=
DEMO_TEST_RECIPIENT_EMAIL=
DEMO_AGENTPHONE_CALL_TARGET=

# Safety toggles for live actions.
DEMO_MODE=true
ALLOW_BROWSER_USE_LIVE_TASK=false
ALLOW_REAL_SMS_SEND=false
ALLOW_REAL_EMAIL_SEND=false
ALLOW_REAL_RESTAURANT_CALLS=false
